{
  "name": "resonance",
  "version": "0.2.0",
  "description": "Two-deck YouTube mixer prototype with mood EQ guidance and desktop audio routing experiments.",
  "author": "iamfatness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamfatness/resonance.git"
  },
  "bugs": {
    "url": "https://github.com/iamfatness/resonance/issues"
  },
  "homepage": "https://resonance.iamfatness.us",
  "keywords": [
    "audio",
    "youtube",
    "mixer",
    "eq",
    "electron",
    "wasapi"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "smoke:browser": "npm run build && node scripts/browser-smoke.mjs",
    "smoke:browser:preview": "node scripts/browser-smoke.mjs",
    "smoke:deploy": "node scripts/browser-smoke.mjs --url=https://resonance.iamfatness.us/app",
    "desktop:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-electron-dev.ps1",
    "desktop:run": "npm run build && electron .",
    "desktop:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop-local.ps1",
    "desktop:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-desktop-installer.ps1",
    "audio:devices": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/list-audio-devices.ps1",
    "native:wasapi-meter": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-wasapi-meter.ps1",
    "native:audio-router": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-router.ps1",
    "native:vst3-bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-vst3-bridge.ps1",
    "driver:install:wdk-buildtools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-wdk-buildtools.ps1",
    "driver:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/driver-preflight.ps1",
    "driver:capture-readiness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/driver-capture-readiness.ps1",
    "driver:customize:resonance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/customize-sysvad-resonance.ps1",
    "driver:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-sysvad.ps1",
    "driver:package-signing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-driver-signing.ps1",
    "driver:verify-signing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-driver-signing.ps1",
    "driver:install:sysvad": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-sysvad.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "deploy": "npm run build && wrangler pages deploy dist --project-name resonance --branch main --commit-dirty=true",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.jsonc"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "us.iamfatness.resonance",
    "productName": "Resonance",
    "asar": false,
    "compression": "normal",
    "directories": {
      "output": "release/installer"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "engine/**/*",
      "scripts/list-audio-devices.ps1",
      "native/wasapi-meter/build/Release/resonance-wasapi-meter.exe",
      "native/audio-router/build/Release/resonance-audio-router.exe",
      "native/vst3-bridge/build/Release/resonance-vst3-bridge.exe",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Resonance"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.60.0",
    "prettier": "^3.7.4",
    "vitest": "^4.0.15",
    "wrangler": "^4.95.0"
  }
}
